{
  "name": "yolcu-kapmaca",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tools && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "format": "prettier --write src",
    "test": "node tests/smoke.mjs && node tests/scenes.mjs",
    "test:parity": "node tests/parity.mjs",
    "test:perf": "node tests/perf.mjs",
    "sim": "vite build --ssr tools/headless.ts --outDir dist-node --emptyOutDir --logLevel warn && node dist-node/headless.js",
    "ekonomi": "node tools/ekonomi-sim.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
